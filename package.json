{
  "name": "macro-factor-clone",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.22",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-sharing": "~58.0.22",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@storybook/react-native-web-vite": "10.6.5",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "oxlint": "1.91.0",
    "storybook": "10.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "storybook": "storybook dev -c storybook -p 6006 --host 0.0.0.0 --no-open --disable-telemetry",
    "build-storybook": "storybook build -c storybook --disable-telemetry",
    "test:storybook": "node storybook/verify.mjs",
    "typecheck": "tsc --noEmit",
    "export:ios": "expo export --platform ios",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'src/**/*.test.ts'",
    "lint": "oxlint --deny-warnings"
  },
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
